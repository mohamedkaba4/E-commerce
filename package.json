{
  "name": "mavencrest-store",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:store": "npm run start --workspace=apps/storefront",
    "start:admin": "npm run start --workspace=apps/admin -- --port 3001",
    "dev:store": "npm run dev --workspace=apps/storefront",
    "dev:admin": "npm run dev --workspace=apps/admin -- --port 3001",
    "build:store": "npm run build --workspace=apps/storefront",
    "build:admin": "npm run build --workspace=apps/admin",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0"
  }
}
